{
  "project": "project-slim",
  "gate": [
    "./bin/.build-full"
  ],
  "outputs": [
    "var/coverage/full"
  ],
  "directories": [
    "var/cache"
  ],
  "environment": {
    "PROJECT_SLIM_RUNTIME_IMAGE": "{project}-web",
    "PROJECT_SLIM_CHECKOUT": "{checkout}",
    "PROJECT_SLIM_HTTP_PORT": "0"
  },
  "startup": [
    "sh",
    "-ec",
    "test -f vendor/autoload.php || { echo \"Run ./bin/composer install first\" >&2; exit 1; }"
  ],
  "images": [
    "web"
  ],
  "https_preview": {"service": "web", "network": "default", "port": 8080}
}
