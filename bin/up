#!/usr/bin/env sh
set -eu
[ "$#" -eq 0 ] || { echo 'Usage: ./bin/up (no options; exports are documented in README.md)' >&2; exit 2; }
. "$(dirname -- "$0")/../scripts/development-runtime.sh"
runtime_require_dependencies
runtime_compose up --detach --build --no-deps --wait web
runtime_address=$(runtime_compose port web 8080)
printf 'Development URL: http://%s\n' "$runtime_address"
