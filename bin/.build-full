#!/usr/bin/env sh
set -eu
[ "$#" -eq 0 ] || { echo 'Usage: ./bin/build (no arguments)' >&2; exit 2; }
build_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)

# Preserve TASK-00008's host planning-before-Docker boundary.
printf '\n==> Planning (read-only, host)\n'
command -v python3 >/dev/null 2>&1 || { echo 'Python 3 is required on the host for ./bin/planning-check.' >&2; exit 1; }
"$build_root/bin/planning-check"
printf 'PASS: Planning\n'

. "$build_root/scripts/development-runtime.sh"
runtime_require_service
runtime_require_dependencies
runtime_compose exec -T web php scripts/build.php
