#!/usr/bin/env sh
set -eu

./bin/planning-check

image=${PROJECT_SLIM_BUILD_IMAGE:-project-slim-build}
git_common_dir=$(git rev-parse --path-format=absolute --git-common-dir)
iidfile=$(mktemp)
trap 'rm -f "$iidfile"' EXIT HUP INT TERM
docker build --pull --file etc/docker/cli/Dockerfile --tag "$image" --iidfile "$iidfile" .
image_id=$(tr -d '\n' < "$iidfile")
printf 'Build image: %s (%s)\n' "$image" "$image_id"
docker run --rm --volume "$(pwd):/app" --volume "$git_common_dir:$git_common_dir:ro" \
  --workdir /app "$image_id" sh -ec '
  php scripts/check-php-runtime.php
  composer validate
  composer install --no-interaction --prefer-dist --no-progress
  composer check-platform-reqs

  php scripts/test.php

'
