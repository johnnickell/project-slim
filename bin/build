#!/usr/bin/env sh
set -eu

image=project-slim-build
git_common_dir=$(git rev-parse --path-format=absolute --git-common-dir)
docker build --file etc/docker/cli/Dockerfile --tag "$image" .
docker run --rm --volume "$(pwd):/app" --volume "$git_common_dir:$git_common_dir:ro" \
  --workdir /app "$image" sh -ec '
  composer validate
  composer install --no-interaction --prefer-dist --no-progress

  ./bin/planning-check
  php vendor/bin/phpunit

'
