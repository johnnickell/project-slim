{
  "name": "johnnickell/project-slim",
  "description": "Public Slim application composition for Fight libraries.",
  "license": "MIT",
  "type": "project",
  "require": {
    "doctrine/dbal": "^4.3",
    "doctrine/orm": "^3.5",
    "guzzlehttp/guzzle": "^7.10",
    "php": "^8.3",
    "johnnickell/fight-access-control": "dev-develop",
    "johnnickell/fight-common": "dev-develop#4a798b1db8fdb5e4af7d0ba8c98a88ac53c50c16 as 1.2.0-dev",
    "league/flysystem": "^3.30",
    "league/flysystem-local": "^3.30",
    "monolog/monolog": "^3.9",
    "php-di/php-di": "^7.0",
    "php-di/slim-bridge": "^3.4",
    "psr/cache": "^3.0",
    "psr/container": "^2.0",
    "psr/http-client": "^1.0",
    "psr/http-factory": "^1.1",
    "psr/http-message": "^2.0",
    "psr/http-server-handler": "^1.0",
    "psr/log": "^3.0",
    "psr/simple-cache": "^3.0",
    "slim/psr7": "^1.8",
    "slim/csrf": "^1.5",
    "slim/slim": "^4.15",
    "slim/twig-view": "^3.4",
    "symfony/cache": "^8.1",
    "symfony/console": "^8.1",
    "symfony/finder": "^8.1",
    "symfony/mailer": "^8.1",
    "symfony/mercure": "^0.7",
    "symfony/messenger": "^8.1",
    "symfony/process": "^8.1",
    "symfony/scheduler": "^8.1",
    "symfony/validator": "^8.1",
    "twilio/sdk": "^8.8",
    "twig/twig": "^3.22"
  },
  "require-dev": {"phpunit/phpunit": "^10.5"},
  "autoload": {"psr-4": {"App\\": "src/"}},
  "autoload-dev": {"psr-4": {"Tests\\": "tests/"}},
  "repositories": [
    {"type": "vcs", "url": "https://github.com/johnnickell/fight-common", "no-api": true},
    {"type": "vcs", "url": "https://github.com/johnnickell/fight-access-control", "no-api": true}
  ],
  "config": {"platform": {"php": "8.5.4"}, "optimize-autoloader": true, "preferred-install": "dist", "sort-packages": true},
  "minimum-stability": "dev",
  "prefer-stable": true,
  "scripts": {"test": "phpunit"}
}
